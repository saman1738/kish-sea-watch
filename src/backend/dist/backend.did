type WarningSeverity = 
 variant {
   advisory;
   danger;
   info;
   warning;
 };
type WarningId = nat;
type Warning = 
 record {
   beachId: opt BeachId;
   id: WarningId;
   issuedAt: Timestamp;
   messageEn: text;
   messageFa: text;
   published: bool;
   severity: WarningSeverity;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Timestamp = int;
type ReviewStatus = 
 variant {
   dismissed;
   unverified;
   verified;
 };
type Result__2 = 
 variant {
   err: Error__1;
   ok;
 };
type Result__1 = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type Result_3 = 
 variant {
   err: Error;
   ok: vec Warning;
 };
type Result_2 = 
 variant {
   err: Error;
   ok: Warning;
 };
type Result_1 = 
 variant {
   err: Error;
   ok: Report;
 };
type Result = 
 variant {
   err: Error;
   ok: Beach;
 };
type ReportKind = 
 variant {
   calmWater;
   jellyfish;
   otherHazard;
   roughWater;
   strongCurrents;
   unusualWaves;
   waterClarity;
 };
type ReportId = nat;
type Report = 
 record {
   beachId: BeachId;
   id: ReportId;
   kind: ReportKind;
   note: text;
   reviewedAt: opt Timestamp;
   status: ReviewStatus;
   submittedAt: Timestamp;
 };
type Error__1 = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Error = 
 variant {
   invalidInput: text;
   notAuthorized;
   notFound;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type BeachId = nat;
type Beach = 
 record {
   active: bool;
   descriptionEn: text;
   descriptionFa: text;
   id: BeachId;
   latitude: float64;
   longitude: float64;
   nameEn: text;
   nameFa: text;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__2);
  _internet_identity_sign_in_start: () -> (blob);
  addBeach: (nameEn: text, nameFa: text, latitude: float64, longitude:
   float64, descriptionEn: text, descriptionFa: text) -> (Result);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  createWarning: (beachId: opt nat, messageEn: text, messageFa: text,
   severity: WarningSeverity, published: bool) -> (Result_2);
  ensureBeachesSeeded: () -> ();
  execute: (qJson: text) -> (Result__1) query;
  getApiDoc: () -> (text) query;
  getBeach: (id: BeachId) -> (opt Beach) query;
  getCallerUserRole: () -> (UserRole) query;
  isCallerAdmin: () -> (bool) query;
  listAllWarnings: () -> (Result_3) query;
  listBeaches: () -> (vec Beach) query;
  listPublishedWarnings: () -> (vec Warning) query;
  listReports: () -> (vec Report) query;
  listReportsForBeach: (beachId: nat) -> (vec Report) query;
  reviewReport: (id: ReportId, status: ReviewStatus) -> (Result_1);
  schema: () -> (text) query;
  setWarningPublished: (id: WarningId, published: bool) -> (Result_2);
  submitReport: (beachId: nat, kind: ReportKind, note: text) -> (Result_1);
  updateBeach: (id: BeachId, nameEn: text, nameFa: text, latitude: float64,
   longitude: float64, descriptionEn: text, descriptionFa: text, active:
   bool) -> (Result);
}
